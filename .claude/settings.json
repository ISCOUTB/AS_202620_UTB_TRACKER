{
  "permissions": {
    "deny": [
      "Read(./venv/**)",
      "Read(./.venv/**)",
      "Read(./graphify-out/cache/**)",
      "Read(./graphify-out/graph.json)",
      "Read(./docs/arc42/images/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Mateo/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Mateo/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}