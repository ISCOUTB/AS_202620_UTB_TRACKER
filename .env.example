# ─── UTB Tracker — Variables de entorno ───────────────────────────────────
# Copiar como .env y ajustar los valores.

# Base de datos (SQLite en local, PostgreSQL en producción)
DATABASE_URL=postgresql://user:password@localhost:5432/utb_tracker
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/utb_tracker_test

# JWT
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FORGET_PWD_SECRET_KEY=your-forget-pwd-secret-change-in-production
# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
REFRESH_TOKEN_EXPIRE_DAYS=7
RECUPERACION_EXPIRA_MINUTOS=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
# Endpoints que envían correo: máximo CORREO_RATE_LIMIT por ventana, por cuenta/correo y por IP.
CORREO_RATE_LIMIT=3
CORREO_RATE_WINDOW_SECONDS=900

# Base de los enlaces de los correos (dónde responde la API). En producción, https; si no se
# define, en producción o con correo real se usa https://129-80-171-141.nip.io.
URL_PUBLICA=http://127.0.0.1:8000

# CORS (separar orígenes por coma; usar * para permitir todos)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Entorno
ENVIRONMENT=development

# Correo (ADR-0015). Con USE_REAL_MAIL=false NO se envía nada: cada correo se guarda completo
# (con su enlace) en CORREOS_DIR para probar el flujo sin cuenta de correo.
USE_REAL_MAIL=false
CORREOS_DIR=logs/correos
# Exigir correo verificado para solicitar salones. Por defecto = USE_REAL_MAIL (sin correo real
# el enlace nunca llegaría). En local con logs/correos ponla en true para probar el flujo.
VERIFICACION_OBLIGATORIA=true
# Dominios de correo admitidos en registros y cambios de correo nuevos (ADR-0019), separados
# por coma. Coincidencia EXACTA (un subdominio como estudiantes.utb.edu.co no entra si no está).
# Sin la variable vale utb.edu.co: producción NO necesita definirla. Solo en desarrollo puedes
# ampliarla, p. ej.: DOMINIOS_PERMITIDOS=utb.edu.co,example.com
DOMINIOS_PERMITIDOS=utb.edu.co
# Solo necesarios cuando USE_REAL_MAIL=true (STARTTLS, puerto 587). Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_USERNAME=tu.cuenta@gmail.com
#   SMTP_PASSWORD=<contraseña de aplicación de 16 letras>  SMTP_FROM=UTB Tracker <tu.cuenta@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Cada cuántos segundos revisa el worker el outbox (el correo de verificación llega en ~ este tiempo).
WORKER_POLL_INTERVAL=3

# Firebase Admin SDK (solo para envío push desde el worker)
USE_REAL_PUSH=false
FIREBASE_CREDENTIALS_PATH=
