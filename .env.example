# Plantilla de variables de entorno para UTB Tracker.
# Copia este archivo como .env y rellena los valores reales (NUNCA subas .env al repositorio).

# URL de conexión a PostgreSQL
# Formato: postgresql+psycopg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg://utb:tu_contraseña@localhost:5432/utb_tracker

# BD exclusiva para pytest — mismo servidor, nombre distinto.
# Los tests NUNCA tocan DATABASE_URL; usan esta BD y la limpian entre corridas.
TEST_DATABASE_URL=postgresql+psycopg://utb:tu_contraseña@localhost:5432/utb_tracker_test

# Clave secreta para firmar los JWT (usa una cadena aleatoria larga, mínimo 32 caracteres)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga

# Algoritmo JWT (no cambiar salvo decisión de equipo — ver ADR-0004)
JWT_ALGORITHM=HS256

# Tiempo de expiración del token en minutos
JWT_EXPIRE_MINUTES=60
