# ─── UTB Tracker — Variables de entorno ───────────────────────────────────
# Copiar como .env y ajustar los valores.

# Base de datos (SQLite en local, PostgreSQL en producción)
DATABASE_URL=postgresql://user:password@localhost:5432/utb_tracker
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/utb_tracker_test

# JWT
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FORGET_PWD_SECRET_KEY=your-forget-pwd-secret-change-in-production

# CORS (separar orígenes por coma; usar * para permitir todos)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Entorno
ENVIRONMENT=development
